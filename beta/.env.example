# Never prefix these secrets with VITE_. This file is an example, not credentials.
APP_ORIGIN=http://127.0.0.1:5173
PORT=5174
HOST=127.0.0.1
DATA_DIRECTORY=.data
# Optional: exactly 64 hexadecimal characters. Otherwise a private .data/key is generated.
DATA_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Picker uses the OAuth token and this Cloud project number.
GOOGLE_APP_ID=
