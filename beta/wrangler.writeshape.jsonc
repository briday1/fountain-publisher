{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "writeshape-private-test",
  "main": "cloudflare/beta.ts",
  "account_id": "7d2c102e83d54e0c10abed8a3253dc20",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "writeshape.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [{ "binding": "SHARED_API", "service": "fountain-publisher" }],
  "vars": {
    "BETA_ORIGIN": "https://writeshape.com",
    "SHARED_ORIGIN": "https://fountain-publisher.com",
    "API_ORIGIN": "https://api.fountain-publisher.com"
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE_ROOMS", "class_name": "LiveScreenplayRoom" }]
  },
  "migrations": [
    {
      "tag": "writeshape-live-structured-v1",
      "new_sqlite_classes": ["LiveScreenplayRoom"]
    }
  ],
  "observability": { "enabled": true }
}
