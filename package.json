{
  "name": "fountain-publisher",
  "private": true,
  "version": "1.0.0",
  "description": "A web app for editing and publishing Fountain screenplays.",
  "scripts": {
    "postinstall": "npm --prefix beta ci",
    "dev": "npm --prefix beta run dev --",
    "prestart": "npm run build",
    "start": "npm --prefix beta start --",
    "build": "npm --prefix beta run build --",
    "build:web": "npm run build --",
    "build:beta": "npm --prefix beta run build:beta --",
    "test": "npm --prefix beta test --",
    "test:watch": "npm --prefix beta run test:watch --",
    "test:browser": "npm --prefix beta run test:browser --",
    "check": "npm test && npm run build",
    "format": "npm --prefix beta run format --"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
